# Your DuckDNS name without .duckdns.org
DUCKDNS_SUBDOMAIN=yourname
# The token shown at the top of duckdns.org after you sign in
DUCKDNS_TOKEN=your-duckdns-token
# Database passwords: any long random text (python3 -c "import secrets; print(secrets.token_hex(16))")
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_PASSWORD=replace-me
